{
  "$comment": "yaa dark theme. Source of truth for colours, spacing and type; the app themes are generated from this shape. Never use literals in components. Surfaces go from the frame (darkest) through the menu and panels to overlays (lightest); docs/design/ui.md maps each to the part of the window it paints. The light theme has the same shape and is designed in M6.",
  "font": {
    "sans": "\"Geist Variable\", sans-serif",
    "mono": "\"Geist Mono Variable\", monospace",
    "size": { "xs": "13.5px", "sm": "14px", "md": "14.5px", "base": "15px", "lg": "16px", "title": "18px", "wordmark": "20px" },
    "lineHeight": { "tight": "20px", "base": "22px" },
    "weight": { "medium": "500", "semibold": "600" }
  },
  "radius": { "overlay": "10px", "panel": "8px", "control": "6px", "chip": "4px" },
  "shadow": { "overlay": "0 16px 48px rgba(0, 0, 0, 0.45)" },
  "space": { "0": "0px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "2.5": "10px", "3": "12px", "3.5": "14px", "4": "16px", "4.5": "18px" },
  "size": {
    "row": "24px",
    "panelGap": "8px",
    "focusTop": "1px",
    "focusSide": "1px",
    "kbd": "20px",
    "control": "26px",
    "controlLg": "32px",
    "panelHeader": "36px",
    "header": "40px",
    "footer": "28px",
    "menu": "248px",
    "graph": "42px",
    "palette": "620px",
    "paletteOffset": "96px"
  },
  "density": {
    "$comment": "Multiplier applied to space and size tokens. Only comfortable ships in v1.",
    "comfortable": 1
  },
  "color": {
    "chrome": "#0b0d12",
    "grid": "#1a1e27",
    "menu": "#0f1218",
    "rail": "#12151c",
    "surface": "#12151c",
    "panelHeader": "#0f1218",
    "panelHeaderHover": "#13161e",
    "raised": "#181c25",
    "overlay": "#171b24",
    "hover": "#1c212b",
    "pressed": "#20252f",
    "selection": "#232835",
    "border": "#1d222b",
    "borderStrong": "#2a303c",
    "text": "#e1e5ec",

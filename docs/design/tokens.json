    "state": {
      "idle": "#7b8495",
      "running": "#73b8ff",
      "attention": "#ffb454",
      "error": "#d95757",
      "done": "#70bf56"
    },
    "syntax": {
      "keyword": "#c4a7f2",
      "string": "#a3d18c",
      "number": "#f0b183",
      "comment": "#737d8f",
      "type": "#82d0c8"

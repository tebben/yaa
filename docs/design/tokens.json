{
  "$comment": "yaa dark theme, based on Ayu Dark. Source of truth for colours, spacing and type; the app themes are generated from this shape. Never use literals in components. The light theme has the same shape and is designed in M6.",
  "font": {
    "sans": "\"Geist Variable\", sans-serif",
    "mono": "\"Geist Mono Variable\", monospace",
    "size": { "xs": "13.5px", "sm": "14px", "md": "14.5px", "base": "15px", "lg": "16px", "title": "18px", "wordmark": "20px" },
    "lineHeight": { "tight": "20px", "base": "22px" },
    "weight": { "semibold": "600" }
  },
  "radius": { "panel": "6px", "control": "4px", "chip": "3px" },
  "space": { "0": "0px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "2.5": "10px", "3": "12px", "3.5": "14px", "4": "16px" },
  "size": {
    "row": "24px",
    "panelGap": "8px",
    "icon": "18px",
    "control": "26px",
    "controlLg": "28px",
    "panelHeader": "32px",
    "header": "36px",
    "footer": "28px",
    "menu": "248px",
    "rail": "42px",
    "palette": "620px",
    "paletteOffset": "96px"
  },
  "density": {
    "$comment": "Multiplier applied to space and size tokens. Only comfortable ships in v1.",
    "comfortable": 1
  },
  "color": {
    "chrome": "#0d1017",
    "grid": "#1a1e27",
    "menu": "#121620",
    "menuBorder": "#596779",
    "surface": "#10141c",
    "raised": "#141821",
    "selection": "#29313e",
    "border": "#1b1f29",
    "borderInput": "#364152",
    "text": "#bfbdb5",
    "textSoft": "#a8b2c2",
    "textMuted": "#8995a8",
    "accent": "#e6b450",
    "accentSoft": "#332d20",
    "focus": "#e6b450",
    "state": {
      "idle": "#8995a8",
      "running": "#73b8ff",
      "attention": "#ffb454",
      "error": "#d95757",
      "done": "#70bf56"
    },
    "diff": {
      "added": "rgba(112, 191, 86, 0.13)",
      "removed": "rgba(242, 109, 120, 0.13)",
      "changed": "rgba(115, 184, 255, 0.13)"
    }
  }
}

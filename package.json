{
	"name": "yaa",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "biome check . && node scripts/check-suppressions.ts",
		"format": "biome check --write .",
		"typecheck": "tsc -p . && tsc -p tsconfig.preload.json && svelte-check --tsconfig ./tsconfig.web.json",
		"dev": "pnpm --filter @yaa/desktop dev",
		"test": "pnpm -r --filter '!yaa' test",
		"lint:boundaries": "depcruise --config .dependency-cruiser.cjs .",
		"lint:svelte-size": "node scripts/svelte-size.ts",
		"check:docs": "node scripts/check-docs.ts",
		"test:changed": "pnpm -r --filter '...[origin/main]' --filter '!yaa' test",
		"check": "pnpm run check:static && pnpm run test:changed",
		"check:all": "pnpm run check:static && pnpm run test",
		"check:static": "pnpm run lint && pnpm run typecheck && pnpm run lint:boundaries && pnpm run lint:svelte-size && pnpm run check:docs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^24.19.3",
		"dependency-cruiser": "^18.9.0",
		"svelte": "~5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "~5.1.1"
	}
}

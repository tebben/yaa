{
	"id": "fake-agent",
	"version": "0.1.0",
	"main": "dist/main.js",
	"agent": "dist/agent.js",
	"devOnly": true,
	"contributes": {
		"providers": [
			{
				"id": "fake-agent",
				"title": "Fake agent",
				"capabilities": [
					"resume",
					"effort",
					"usage",
					"discovery",
					"mcp-toggling",
					"skill-toggling"
				],
				"permissionModes": {
					"option": "mode",
					"values": {
						"ask": ["default"],
						"risky": ["acceptEdits"],
						"allow": ["bypassPermissions"]
					}
				}
			}
		]
	}
}

{
	"$comment": "The renderer side: DOM types, no Node. tsconfig.json covers the Node side. apps/web/vite.config.ts and packages/ui/vitest.config.ts run in Node and are checked there.",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": []
	},
	"include": [
		"apps/web",
		"packages/ui",
		"packages/contracts",
		"packages/commands",
		"packages/plugin-api",
		"plugins/*/ui.ts",
		"plugins/*/lib/**/*.svelte",
		"plugins/*/lib/**/*.svelte.ts"
	],
	"exclude": [
		"**/node_modules",
		"**/dist",
		"apps/web/vite.config.ts",
		"packages/ui/vitest.config.ts"
	]
}
